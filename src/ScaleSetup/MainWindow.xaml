<Window x:Class="ScaleSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка весов · LEGO" Width="1180" Height="780"
        MinWidth="1000" MinHeight="660" WindowStartupLocation="CenterScreen"
        Background="#FFF8DA">
  <Window.Resources>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListViewItem">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="8,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#FFE6A2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#FFFFF0B0" />
                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#FFD10B10" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#FFFFF7D8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="100" />
      <RowDefinition Height="68" />
      <RowDefinition Height="*" />
      <RowDefinition Height="112" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="94" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Source="pack://siteoforigin:,,,/Assets/Setup/logo.png" Stretch="Uniform"
             HorizontalAlignment="Left" VerticalAlignment="Center" Width="78" Height="92"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
        <TextBlock Text="ПРИВЯЗКА ВЕСОВ" FontSize="27" FontWeight="Black" Foreground="#171717" />
        <TextBlock Text="Выберите устройство один раз — привязка сохранится после перезапуска ноутбука."
                   FontSize="15" Foreground="#4B4336" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="White" BorderBrush="#FFE6A2" BorderThickness="1"
            CornerRadius="10" Padding="16,8" Margin="0,0,0,14">
      <DockPanel LastChildFill="True">
        <Button x:Name="ScanButton" DockPanel.Dock="Right" Content="Найти весы"
                Click="ScanButton_Click" Style="{StaticResource ActionButton}"
                Background="#D10B10" Foreground="White" Margin="14,0,0,0" />
        <TextBlock x:Name="StatusText" Text="Нажмите «Найти весы», затем встаньте на весы."
                   FontSize="15" Foreground="#34312B" VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="350" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#FFE6A2" BorderThickness="1"
              CornerRadius="10" Padding="10">
        <ListView x:Name="ScaleList" BorderThickness="0" Background="Transparent"
                  SelectionChanged="ScaleList_SelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Margin="3,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="175" />
                  <ColumnDefinition Width="95" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#211F1A" />
                  <TextBlock Text="{Binding Address}" FontSize="13" Foreground="#686052" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                  <TextBlock Text="{Binding ProtocolName}" FontSize="13" Foreground="#37342D"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PacketText}" FontSize="11" Foreground="#777061"
                             Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SignalText}" FontSize="13" Foreground="#514B3F"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Border>

      <Border Grid.Column="1" Background="#FFFFF0B0" BorderBrush="#FFE6A2" BorderThickness="1"
              CornerRadius="10" Padding="20" Margin="14,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="ПОКАЗАНИЯ ВЕСОВ" FontSize="14" FontWeight="Bold"
                     Foreground="#5A5141" />
          <TextBlock x:Name="LatestReadingText" Grid.Row="1"
                     Text="Последнее показание: пока нет данных от весов"
                     FontSize="19" FontWeight="Bold" Foreground="#D10B10"
                     TextWrapping="Wrap" Margin="0,14,0,0" />
          <TextBlock x:Name="ReadingHistoryText" Grid.Row="2"
                     Text="Промежуточные показания: пока нет данных"
                     FontSize="12" Foreground="#514B3F" TextWrapping="Wrap" Margin="0,10,0,0" />
          <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="ПАКЕТЫ ВЫБРАННЫХ ВЕСОВ" FontSize="11" FontWeight="Bold"
                       Foreground="#5A5141" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
              <TextBlock x:Name="AdvertisementHistoryText" Text="Сырые BLE-пакеты: пока нет данных"
                         FontSize="11" Foreground="#514B3F" TextWrapping="Wrap" />
            </ScrollViewer>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="SavedText" Text="Пока не выбраны" FontSize="14" FontWeight="Bold"
                   Foreground="#292720" />
        <TextBlock Text="Поддерживаются Xiaomi Mi Scale 2 и известные варианты BLE-пакетов."
                   FontSize="12" Foreground="#655E50" Margin="0,5,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <Button x:Name="SaveButton" Grid.Column="1" Content="Сохранить выбор"
              Click="SaveButton_Click" IsEnabled="False" Style="{StaticResource ActionButton}"
              Background="#FFD00A" Foreground="#171717" Margin="18,0,0,0" MinWidth="188" />
    </Grid>
  </Grid>
</Window>
