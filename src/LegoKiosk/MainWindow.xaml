<Window x:Class="LegoKiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Весы — LEGO" WindowStyle="None" WindowState="Maximized"
        ResizeMode="NoResize" Topmost="False" Background="#FFD00A"
        Cursor="None" KeyDown="Window_KeyDown">
  <Grid ClipToBounds="True">
    <Image Source="pack://siteoforigin:,,,/Assets/Kiosk/background.tif"
           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />

    <Image x:Name="ExhibitionLogo" Source="pack://siteoforigin:,,,/Assets/Kiosk/logo.png"
           Width="112" Height="132" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="42,34,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
           IsHitTestVisible="False" />

    <Grid x:Name="IdlePanel" Opacity="1" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="IdlePanelScale" ScaleX="1" ScaleY="1" />
      </Grid.RenderTransform>

      <Image x:Name="IdleIllustration" Source="pack://siteoforigin:,,,/Assets/Kiosk/idle-minifigure.png"
             Width="370" Height="390" HorizontalAlignment="Center" VerticalAlignment="Center"
             Margin="0,-34,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
             RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
          <ScaleTransform x:Name="IdleIllustrationScale" ScaleX="1" ScaleY="1" />
        </Image.RenderTransform>
      </Image>

      <TextBlock x:Name="IdlePrompt" Text="ВСТАНЬТЕ НА ВЕСЫ"
                 FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="48"
                 Foreground="#171717" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="36,0,36,72" TextAlignment="Center" />
    </Grid>

    <Grid x:Name="ResultPanel" Visibility="Collapsed" Opacity="1"
          RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="ResultPanelScale" ScaleX="1" ScaleY="1" />
      </Grid.RenderTransform>

      <Grid Margin="0,112,0,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="24*" />
          <RowDefinition Height="44*" />
          <RowDefinition Height="32*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="ResultTitle" Grid.Row="0" Text="КОЛИЧЕСТВО ДЕТАЛЕЙ"
                   FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="42"
                   Foreground="#171717" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="30,0" TextAlignment="Center" Opacity="0"
                   RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform>
            <ScaleTransform x:Name="ResultTitleScale" ScaleX="0.84" ScaleY="0.84" />
          </TextBlock.RenderTransform>
        </TextBlock>

        <Image x:Name="BrickImage" Grid.Row="1" Width="500" Height="310"
               HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" Opacity="0"
               RenderTransformOrigin="0.5,0.5">
          <Image.RenderTransform>
            <ScaleTransform x:Name="BrickImageScale" ScaleX="0.84" ScaleY="0.84" />
          </Image.RenderTransform>
        </Image>

        <TextBlock x:Name="BrickCount" Grid.Row="2" Text="31 000"
                   FontFamily="{StaticResource DisplayFont}" FontWeight="Black" FontSize="104"
                   Foreground="#171717" HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="20,12,20,0" TextAlignment="Center" Opacity="0"
                   RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform>
            <ScaleTransform x:Name="BrickCountScale" ScaleX="0.84" ScaleY="0.84" />
          </TextBlock.RenderTransform>
        </TextBlock>
      </Grid>
    </Grid>

    <Border x:Name="StatusBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,18,12" Background="#99000000" CornerRadius="14" Padding="11,5"
            IsHitTestVisible="False" Visibility="Collapsed">
      <TextBlock x:Name="StatusText" Text="Ожидаю весы" FontSize="12" Foreground="White" />
    </Border>

    <Border x:Name="DebugPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Margin="18,0,0,12" Background="#CC000000" CornerRadius="10" Padding="12,7"
            IsHitTestVisible="False" MaxWidth="1450" Visibility="Collapsed">
      <TextBlock x:Name="DebugText" Text="BLE: ожидание пакетов" FontSize="13"
                 Foreground="White" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
